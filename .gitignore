# Hyprland runtime state
active/omarchy/.config/hypr/state/


# Omarchy runtime/current state
active/omarchy/.config/omarchy/current/
active/omarchy/.config/hypr/shaders/

# Ignore all themes
active/omarchy/.config/omarchy/themes/*
# But do not ignore the custom default themes
!active/omarchy/.config/omarchy/themes/mars2/
!active/omarchy/.config/omarchy/themes/batou2/
!active/omarchy/.config/omarchy/themes/ethereal/
# And do not ignore anything inside custom default themes
!active/omarchy/.config/omarchy/themes/mars2/**
!active/omarchy/.config/omarchy/themes/batou2/**
!active/omarchy/.config/omarchy/themes/ethereal/**


# Cava
active/shared/.config/cava/themes/
active/shared/.config/cava/shaders/
